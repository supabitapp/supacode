+test "Screen: trimLinkTrailingWords" {
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+
+    var s = try init(io, alloc, .{ .cols = 40, .rows = 12, .max_scrollback_bytes = 0 });
+    defer s.deinit();
+    try s.testWriteString("~/work/nas master\n/bin/a -b -c\n/tmp/test folder/file.txt\nhttps://a.io/x?y=1\n/a/b");
+    s.cursorAbsolute(8, 4);
+    try s.testWriteString("next\n/bin/cp -r src/ dst/\n/tmp/My File.txt\n~/work/nas sbertix/foo\n/tmp/foo a/b.txt\n/tmp/a b.7z\n~/a release/1.2");
+
+    const Case = struct { y: u16, link: [2]u16, click: u16, expect: ?[2]u16 };
+    const cases = [_]Case{
+        // Prompt segments after a path are not part of it.
+        .{ .y = 0, .link = .{ 0, 16 }, .click = 13, .expect = null },
+        .{ .y = 0, .link = .{ 0, 16 }, .click = 2, .expect = .{ 0, 9 } },
+        // Arguments after a command path are not part of it.
+        .{ .y = 1, .link = .{ 0, 11 }, .click = 8, .expect = null },
+        .{ .y = 1, .link = .{ 0, 11 }, .click = 1, .expect = .{ 0, 5 } },
+        // A path with spaces stays whole while later words have a `/`.
+        .{ .y = 2, .link = .{ 0, 24 }, .click = 12, .expect = .{ 0, 24 } },
+        .{ .y = 2, .link = .{ 0, 24 }, .click = 2, .expect = .{ 0, 24 } },
+        // A match without spaces is kept whole.
+        .{ .y = 3, .link = .{ 0, 17 }, .click = 5, .expect = .{ 0, 17 } },
+        // Blank cells split words like spaces do.
+        .{ .y = 4, .link = .{ 0, 11 }, .click = 9, .expect = null },
+        .{ .y = 4, .link = .{ 0, 11 }, .click = 1, .expect = .{ 0, 3 } },
+        // The cut is at the first dropped word, even if a path follows.
+        .{ .y = 5, .link = .{ 0, 19 }, .click = 9, .expect = null },
+        .{ .y = 5, .link = .{ 0, 19 }, .click = 12, .expect = null },
+        .{ .y = 5, .link = .{ 0, 19 }, .click = 2, .expect = .{ 0, 6 } },
+        // A trailing file name with an extension is part of the path.
+        .{ .y = 6, .link = .{ 0, 15 }, .click = 2, .expect = .{ 0, 15 } },
+        // A slash word without an extension, like a branch, is dropped.
+        .{ .y = 7, .link = .{ 0, 21 }, .click = 13, .expect = null },
+        .{ .y = 7, .link = .{ 0, 21 }, .click = 2, .expect = .{ 0, 9 } },
+        // Never extends past the match.
+        .{ .y = 8, .link = .{ 0, 7 }, .click = 2, .expect = .{ 0, 7 } },
+        // Extensions may start with a digit, but versions are not extensions.
+        .{ .y = 9, .link = .{ 0, 10 }, .click = 2, .expect = .{ 0, 10 } },
+        .{ .y = 10, .link = .{ 0, 14 }, .click = 2, .expect = .{ 0, 2 } },
+    };
+
+    const at = struct {
+        fn at(screen: *Screen, x: u16, y: u16) Pin {
+            return screen.pages.pin(.{ .active = .{ .x = x, .y = y } }).?;
+        }
+    }.at;
+    for (cases) |c| {
+        const link: Selection = .init(at(&s, c.link[0], c.y), at(&s, c.link[1], c.y), false);
+        const sel = s.trimLinkTrailingWords(link, at(&s, c.click, c.y));
+        const expect = c.expect orelse {
+            try testing.expect(sel == null);
+            continue;
+        };
+        try testing.expectEqual(point.Point{ .screen = .{
+            .x = expect[0],
+            .y = c.y,
+        } }, s.pages.pointFromPin(.screen, sel.?.start()).?);
+        try testing.expectEqual(point.Point{ .screen = .{
+            .x = expect[1],
+            .y = c.y,
+        } }, s.pages.pointFromPin(.screen, sel.?.end()).?);
+    }
+}
