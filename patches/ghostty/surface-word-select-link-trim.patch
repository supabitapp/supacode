+test "StringMap URL match trimmed for double-click" {
+    if (comptime !build_options.oniguruma) return error.SkipZigTest;
+
+    const testing = std.testing;
+    const alloc = testing.allocator;
+    const io = testing.io;
+    const url = @import("../config/url.zig");
+
+    try oni.testing.ensureInit();
+    var re = try oni.Regex.init(
+        url.regex,
+        .{},
+        oni.Encoding.utf8,
+        oni.Syntax.default,
+        null,
+    );
+    defer re.deinit();
+
+    var s = try Screen.init(io, alloc, .{ .cols = 40, .rows = 8, .max_scrollback_bytes = 0 });
+    defer s.deinit();
+    try s.testWriteString("~/work/nas master\n/bin/a -b -c\n/tmp/test folder/file.txt\n/bin/cp -r src/ dst/\n/tmp/My File.txt\n~/work/nas sbertix/foo\n/tmp/foo /tmp/bar");
+
+    const Case = struct { y: u16, click: u16, expect: ?[2]u16 };
+    const cases = [_]Case{
+        .{ .y = 0, .click = 13, .expect = null },
+        .{ .y = 0, .click = 2, .expect = .{ 0, 9 } },
+        .{ .y = 1, .click = 8, .expect = null },
+        .{ .y = 1, .click = 1, .expect = .{ 0, 5 } },
+        .{ .y = 2, .click = 12, .expect = .{ 0, 24 } },
+        .{ .y = 3, .click = 9, .expect = null },
+        .{ .y = 4, .click = 2, .expect = .{ 0, 15 } },
+        .{ .y = 5, .click = 13, .expect = null },
+        .{ .y = 6, .click = 2, .expect = .{ 0, 7 } },
+    };
+
+    for (cases) |c| {
+        const click_pin = s.pages.pin(.{ .active = .{ .x = c.click, .y = c.y } }).?;
+        const line = s.selectLine(.{ .pin = click_pin }).?;
+        const map = try s.selectionStringMap(alloc, .{ .sel = line, .trim = false });
+        defer map.deinit(alloc);
+
+        // Find the match under the click, like Surface.linkAtPin.
+        var it = map.searchIterator(re);
+        const link = while (try it.next()) |m| {
+            var match = m;
+            defer match.deinit();
+            const sel = match.selection();
+            if (sel.contains(&s, click_pin)) break sel;
+        } else return error.TestUnexpectedResult;
+
+        const sel = s.trimLinkTrailingWords(link, click_pin);
+        const expect = c.expect orelse {
+            try testing.expect(sel == null);
+            continue;
+        };
+        try testing.expectEqual(point.Point{ .screen = .{
+            .x = expect[0],
+            .y = c.y,
+        } }, s.pages.pointFromPin(.screen, sel.?.start()).?);
+        try testing.expectEqual(point.Point{ .screen = .{
+            .x = expect[1],
+            .y = c.y,
+        } }, s.pages.pointFromPin(.screen, sel.?.end()).?);
+    }
+}
