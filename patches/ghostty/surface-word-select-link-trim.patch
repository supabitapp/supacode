+/// Trim a link match containing pin to its first space-separated word, or
+/// through the last file name with an extension when only path-like words
+/// lead there, so `/bin/a -b` keeps `/bin/a` while `/tmp/My File.txt` stays
+/// whole. Returns null when pin lands past the result.
+pub fn trimLinkTrailingWords(self: *Screen, sel: Selection, pin: Pin) ?Selection {
+    const ordered = sel.ordered(self, .forward);
+    const start = ordered.start();
+    const limit = ordered.end();
+
+    var trim_end: ?Pin = null;
+    var word_end = start;
+    var in_word = false;
+    var has_slash = false;
+    var has_ext = false;
+    var in_ext = false;
+    var it = start.cellIterator(.right_down, limit);
+    while (true) {
+        const next = it.next();
+        // CellIterator only limits the row, so bound the column too.
+        const done = next == null or limit.before(next.?);
+
+        // Blank cells are word breaks too, like padding in aligned output.
+        const cp: u21 = if (done) ' ' else selectWordCodepoint(next.?) orelse ' ';
+        if (cp == ' ' or cp == '\t') {
+            if (in_word) {
+                if (trim_end == null or has_ext) {
+                    trim_end = word_end;
+                } else if (!has_slash) break;
+            }
+            if (done) break;
+            in_word = false;
+            has_slash = false;
+            has_ext = false;
+            in_ext = false;
+            continue;
+        }
+
+        in_word = true;
+        // An extension is a `.` then alphanumerics with a letter, so `.7z`
+        // counts but a version like `1.2` doesn't.
+        const ascii: u8 = if (cp < 0x80) @intCast(cp) else 0;
+        if (cp == '/') {
+            has_slash = true;
+            has_ext = false;
+            in_ext = false;
+        } else if (cp == '.') {
+            in_ext = true;
+        } else if (in_ext and std.ascii.isAlphabetic(ascii)) {
+            has_ext = true;
+        } else if (!std.ascii.isDigit(ascii)) {
+            in_ext = false;
+        }
+        word_end = next.?;
+    }
+
+    const end = trim_end orelse start;
+    if (end.before(pin)) return null;
+    return .init(start, end, false);
+}
