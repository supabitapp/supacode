+test "OSC 7501: query" {
+    const testing = std.testing;
+
+    var p: Parser = .init(testing.allocator);
+    defer p.deinit();
+
+    nextSlice(&p, "7501;?");
+    try testing.expectEqual(Terminator.st, p.end('\x1b').?.program_status.query);
+
+    p.reset();
+    nextSlice(&p, "7501;?");
+    try testing.expectEqual(Terminator.bel, p.end(0x07).?.program_status.query);
+}
