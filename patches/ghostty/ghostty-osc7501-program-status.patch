+    pub const ProgramStatus = struct {
+        const limits = terminal.osc.program_status;
+        const Action = apprt.action.ProgramStatus;
+
+        state: Action.State,
+        kind: Action.Kind,
+        progress: i8,
+
+        // Each buffer holds the longest value the parser accepts, so
+        // nothing is ever truncated.
+        id: [limits.max_id_bytes:0]u8,
+        app: [limits.max_app_bytes:0]u8,
+        title: [limits.max_title_bytes:0]u8,
+        msg: [limits.max_msg_bytes:0]u8,
+
+        pub fn init(report: terminal.osc.Command.ProgramStatus.Report) ProgramStatus {
+            var result: ProgramStatus = undefined;
+            result.state = .init(report.state);
+            result.kind = .init(report.readOption(.kind));
+            result.progress = if (report.readOption(.progress)) |v| @intCast(v) else -1;
+            copyZ(result.id.len, &result.id, report.readOption(.id) orelse "");
+            copyZ(result.app.len, &result.app, report.readOption(.app) orelse "");
+            writeTextZ(.title, result.title.len, &result.title, report);
+            writeTextZ(.msg, result.msg.len, &result.msg, report);
+            return result;
+        }
+
+        pub fn action(self: *const ProgramStatus) Action {
+            return .{
+                .state = self.state,
+                .kind = self.kind,
+                .progress = self.progress,
+                .id = std.mem.sliceTo(&self.id, 0),
+                .app = std.mem.sliceTo(&self.app, 0),
+                .title = std.mem.sliceTo(&self.title, 0),
+                .msg = std.mem.sliceTo(&self.msg, 0),
+            };
+        }
+
+        fn copyZ(comptime capacity: usize, dst: *[capacity:0]u8, src: []const u8) void {
+            const len = @min(src.len, capacity);
+            @memcpy(dst[0..len], src[0..len]);
+            dst[len] = 0;
+        }
+
+        fn writeTextZ(
+            comptime option: terminal.osc.Command.ProgramStatus.Option,
+            comptime capacity: usize,
+            dst: *[capacity:0]u8,
+            report: terminal.osc.Command.ProgramStatus.Report,
+        ) void {
+            var writer: std.Io.Writer = .fixed(dst[0..capacity]);
+            report.writeText(option, &writer) catch unreachable;
+            dst[writer.buffered().len] = 0;
+        }
+    };
