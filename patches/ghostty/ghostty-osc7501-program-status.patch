+fn testProgramStatus(body: []const u8) !Message.ProgramStatus {
+    var parser: terminal.osc.Parser = .init(std.testing.allocator);
+    defer parser.deinit();
+    parser.nextSlice("7501;");
+    parser.nextSlice(body);
+    const cmd = parser.end(0x07) orelse return error.TestUnexpectedResult;
+    return .init(cmd.program_status.report);
+}
+
+test "ProgramStatus init copies a full report" {
+    const testing = std.testing;
+    // title=Deploy msg=Approve the write?
+    const status = try testProgramStatus(
+        "state=blocked:id=deploy/us-east:kind=permission:progress=40:app=claude-code:title=RGVwbG95:msg=QXBwcm92ZSB0aGUgd3JpdGU/",
+    );
+    const action = status.action();
+    try testing.expectEqual(apprt.action.ProgramStatus.State.blocked, action.state);
+    try testing.expectEqual(apprt.action.ProgramStatus.Kind.permission, action.kind);
+    try testing.expectEqual(@as(i8, 40), action.progress);
+    try testing.expectEqualStrings("deploy/us-east", action.id);
+    try testing.expectEqualStrings("claude-code", action.app);
+    try testing.expectEqualStrings("Deploy", action.title);
+    try testing.expectEqualStrings("Approve the write?", action.msg);
+}
+
+test "ProgramStatus init leaves absent keys empty" {
+    const testing = std.testing;
+    const action = (try testProgramStatus("state=idle")).action();
+    try testing.expectEqual(apprt.action.ProgramStatus.State.idle, action.state);
+    try testing.expectEqual(apprt.action.ProgramStatus.Kind.none, action.kind);
+    try testing.expectEqual(@as(i8, -1), action.progress);
+    try testing.expectEqualStrings("", action.id);
+    try testing.expectEqualStrings("", action.app);
+    try testing.expectEqualStrings("", action.title);
+    try testing.expectEqualStrings("", action.msg);
+}
+
+test "ProgramStatus init drops kind and progress the state does not allow" {
+    const testing = std.testing;
+    const action = (try testProgramStatus("state=done:kind=auth:progress=10")).action();
+    try testing.expectEqual(apprt.action.ProgramStatus.State.done, action.state);
+    try testing.expectEqual(apprt.action.ProgramStatus.Kind.none, action.kind);
+    try testing.expectEqual(@as(i8, -1), action.progress);
+}
+
+test "ProgramStatus init keeps working progress and clear ids" {
+    const testing = std.testing;
+    const working = (try testProgramStatus("state=working:progress=100:app=codex")).action();
+    try testing.expectEqual(apprt.action.ProgramStatus.State.working, working.state);
+    try testing.expectEqual(@as(i8, 100), working.progress);
+    try testing.expectEqualStrings("codex", working.app);
+
+    const clear = (try testProgramStatus("state=clear:id=agent/sub")).action();
+    try testing.expectEqual(apprt.action.ProgramStatus.State.clear, clear.state);
+    try testing.expectEqualStrings("agent/sub", clear.id);
+}
+
+test "ProgramStatus init fits the longest values the parser accepts" {
+    const testing = std.testing;
+    const limits = terminal.osc.program_status;
+    const alloc = testing.allocator;
+
+    const msg_text = "m" ** limits.max_msg_bytes;
+    const title_text = "t" ** limits.max_title_bytes;
+    const encoder = std.base64.standard.Encoder;
+    var msg_b64: [encoder.calcSize(msg_text.len)]u8 = undefined;
+    var title_b64: [encoder.calcSize(title_text.len)]u8 = undefined;
+    const app = "a" ** limits.max_app_bytes;
+    const segment = "s" ** limits.max_id_segment_bytes;
+    const id = segment ++ "/" ++ segment ++ "/" ++ segment ++ "/" ++ "s" ** 29;
+    comptime std.debug.assert(id.len == limits.max_id_bytes);
+
+    const body = try std.fmt.allocPrint(alloc, "state=working:id={s}:app={s}:title={s}:msg={s}", .{
+        id,
+        app,
+        encoder.encode(&title_b64, title_text),
+        encoder.encode(&msg_b64, msg_text),
+    });
+    defer alloc.free(body);
+
+    const action = (try testProgramStatus(body)).action();
+    try testing.expectEqualStrings(id, action.id);
+    try testing.expectEqualStrings(app, action.app);
+    try testing.expectEqualStrings(title_text, action.title);
+    try testing.expectEqualStrings(msg_text, action.msg);
+}
