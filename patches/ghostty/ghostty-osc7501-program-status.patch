+pub const ProgramStatus = struct {
+    state: State,
+    kind: Kind = .none,
+
+    /// -1 if no progress was reported, otherwise 0-100.
+    progress: i8 = -1,
+
+    /// Empty when the report didn't carry the key. An empty id
+    /// addresses the root record.
+    id: [:0]const u8 = "",
+    app: [:0]const u8 = "",
+    title: [:0]const u8 = "",
+    msg: [:0]const u8 = "",
+
+    /// Sync with: ghostty_action_program_status_state_e
+    pub const State = enum(c_int) {
+        idle,
+        working,
+        done,
+        blocked,
+        @"error",
+        clear,
+
+        pub fn init(state: terminal.osc.Command.ProgramStatus.State) State {
+            return switch (state) {
+                inline else => |tag| @field(State, @tagName(tag)),
+            };
+        }
+
+        test "ghostty.h ProgramStatus.State" {
+            try lib.checkGhosttyHEnum(State, "GHOSTTY_ACTION_PROGRAM_STATUS_STATE_");
+        }
+    };
+
+    /// Sync with: ghostty_action_program_status_kind_e
+    pub const Kind = enum(c_int) {
+        none,
+        permission,
+        question,
+        auth,
+
+        pub fn init(kind: ?terminal.osc.Command.ProgramStatus.Kind) Kind {
+            return if (kind) |k| switch (k) {
+                inline else => |tag| @field(Kind, @tagName(tag)),
+            } else .none;
+        }
+
+        test "ghostty.h ProgramStatus.Kind" {
+            try lib.checkGhosttyHEnum(Kind, "GHOSTTY_ACTION_PROGRAM_STATUS_KIND_");
+        }
+    };
+
+    // Sync with: ghostty_action_program_status_s
+    pub const C = extern struct {
+        state: State,
+        kind: Kind,
+        progress: i8,
+        id: [*:0]const u8,
+        app: [*:0]const u8,
+        title: [*:0]const u8,
+        msg: [*:0]const u8,
+    };
+
+    pub fn cval(self: ProgramStatus) C {
+        return .{
+            .state = self.state,
+            .kind = self.kind,
+            .progress = self.progress,
+            .id = self.id.ptr,
+            .app = self.app.ptr,
+            .title = self.title.ptr,
+            .msg = self.msg.ptr,
+        };
+    }
+
+    test "cval keeps every field" {
+        const testing = std.testing;
+        const value: ProgramStatus = .{
+            .state = .blocked,
+            .kind = .permission,
+            .progress = 40,
+            .id = "deploy/us-east",
+            .app = "claude-code",
+            .title = "Deploy",
+            .msg = "Approve the write?",
+        };
+        const c = value.cval();
+        try testing.expectEqual(State.blocked, c.state);
+        try testing.expectEqual(Kind.permission, c.kind);
+        try testing.expectEqual(@as(i8, 40), c.progress);
+        try testing.expectEqualStrings("deploy/us-east", std.mem.span(c.id));
+        try testing.expectEqualStrings("claude-code", std.mem.span(c.app));
+        try testing.expectEqualStrings("Deploy", std.mem.span(c.title));
+        try testing.expectEqualStrings("Approve the write?", std.mem.span(c.msg));
+    }
+
+    test "cval of a bare report" {
+        const testing = std.testing;
+        const c = (ProgramStatus{ .state = .idle }).cval();
+        try testing.expectEqual(Kind.none, c.kind);
+        try testing.expectEqual(@as(i8, -1), c.progress);
+        try testing.expectEqualStrings("", std.mem.span(c.id));
+        try testing.expectEqualStrings("", std.mem.span(c.app));
+    }
+
+    test "State.init maps every parser state" {
+        const testing = std.testing;
+        const Parsed = terminal.osc.Command.ProgramStatus.State;
+        inline for (@typeInfo(Parsed).@"enum".fields) |field| {
+            const mapped = State.init(@field(Parsed, field.name));
+            try testing.expectEqualStrings(field.name, @tagName(mapped));
+        }
+    }
+
+    test "Kind.init maps every parser kind and null" {
+        const testing = std.testing;
+        const Parsed = terminal.osc.Command.ProgramStatus.Kind;
+        inline for (@typeInfo(Parsed).@"enum".fields) |field| {
+            const mapped = Kind.init(@field(Parsed, field.name));
+            try testing.expectEqualStrings(field.name, @tagName(mapped));
+        }
+        try testing.expectEqual(Kind.none, Kind.init(null));
+    }
+};
