+
+    /// Answer the OSC 7501 support query and forward reports to the
+    /// surface, which keeps the records (see apprt.action.ProgramStatus).
+    fn programStatus(
+        self: *StreamHandler,
+        cmd: terminal.osc.Command.ProgramStatus,
+    ) !void {
+        switch (cmd) {
+            // Reply on the termio write path, like DA1, so a program that
+            // follows its query with DA1 sees our reply first. Programs only
+            // report once they see the reply, so `program-status` gates it.
+            .query => |terminator| if (self.program_status) {
+                const reply = terminal.osc.program_status.query_reply;
+                self.messageWriter(.{ .write_stable = switch (terminator) {
+                    .st => "\x1b]7501;" ++ reply ++ "\x1b\\",
+                    .bel => "\x1b]7501;" ++ reply ++ "\x07",
+                } });
+            },
+
+            // The report points into the parser buffer, so copy it
+            // before this returns.
+            .report => |report| self.surfaceMessageWriter(.{ .program_status = .{ .report = .{
+                .state = report.state,
+                .data = try apprt.surface.Message.WriteReq.init(self.alloc, report.data),
+            } } }),
+        }
+    }
