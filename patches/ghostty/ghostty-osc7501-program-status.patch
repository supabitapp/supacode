+    /// Forward an OSC 7501 report to the surface, or answer the support
+    /// query. The reply is fixed bytes, and the specification never lets
+    /// a terminal echo report contents back to the program.
+    fn programStatus(self: *StreamHandler, cmd: terminal.osc.Command.ProgramStatus) void {
+        switch (cmd) {
+            .report => |report| self.surfaceMessageWriter(.{ .program_status = .init(report) }),
