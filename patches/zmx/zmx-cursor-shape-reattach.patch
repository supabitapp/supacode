+test "CursorShapeTracker captures the last DECSCUSR" {
+    var tracker = CursorShapeTracker{};
+    tracker.track("\x1b[5 q"); // blinking bar
+    try testing.expectEqualStrings("\x1b[5 q", tracker.sequence().?);
+    tracker.track("text \x1b[4 q more"); // steady underline wins
+    try testing.expectEqualStrings("\x1b[4 q", tracker.sequence().?);
+}
+
+test "CursorShapeTracker reassembles a split DECSCUSR" {
+    var tracker = CursorShapeTracker{};
+    tracker.track("\x1b[6"); // steady bar, split mid-sequence
+    tracker.track(" q");
+    try testing.expectEqualStrings("\x1b[6 q", tracker.sequence().?);
+}
+
+test "CursorShapeTracker captures a default-reset DECSCUSR" {
+    var tracker = CursorShapeTracker{};
+    tracker.track("\x1b[0 q"); // reset the cursor to the terminal default
+    try testing.expectEqualStrings("\x1b[0 q", tracker.sequence().?);
+}
+
+test "CursorShapeTracker accepts a zero-padded parameter" {
+    var tracker = CursorShapeTracker{};
+    tracker.track("\x1b[05 q"); // ghostty parses 05 as style 5 (blinking bar)
+    try testing.expectEqualStrings("\x1b[05 q", tracker.sequence().?);
+}
+
+test "CursorShapeTracker ignores non-DECSCUSR sequences" {
+    var tracker = CursorShapeTracker{};
+    tracker.track("\x1b[0m\x1b[1\"q\x1b[2J"); // SGR reset, DECSCA, erase
+    try testing.expect(tracker.sequence() == null);
+    tracker.track("\x1b[42 q\x1b[5;3 q"); // out-of-range and multi-param are rejected
+    try testing.expect(tracker.sequence() == null);
+}
+
+test "CursorShapeTracker keeps its capture across later escapes and text" {
+    var tracker = CursorShapeTracker{};
+    tracker.track("\x1b[5 q");
+    // Unrelated escapes arriving after the capture must not disturb it.
+    tracker.track("\x1b[0m\x1b[2J\x1b[1\"q\x1b[10;5H"); // SGR, erase, DECSCA, CUP
+    try testing.expectEqualStrings("\x1b[5 q", tracker.sequence().?);
+    // Plain output takes the ground-state fast path and must not disturb it either.
+    tracker.track("a line of ordinary text with no escapes\n");
+    try testing.expectEqualStrings("\x1b[5 q", tracker.sequence().?);
+}
+
+test "CursorShapeTracker overflow drops the runt without wiping a capture" {
+    var tracker = CursorShapeTracker{};
+    tracker.track("\x1b[5 q");
+    // A parameter body longer than the buffer overflows and is discarded.
+    tracker.track("\x1b[00000000000000000 q");
+    try testing.expectEqualStrings("\x1b[5 q", tracker.sequence().?);
+
+    var fresh = CursorShapeTracker{};
+    fresh.track("\x1b[00000000000000000 q");
+    try testing.expect(fresh.sequence() == null);
+}
+
+test "CursorShapeTracker clears on RIS and DECSTR" {
+    var tracker = CursorShapeTracker{};
+    tracker.track("\x1b[5 q");
+    try testing.expect(tracker.sequence() != null);
+    tracker.track("\x1bc"); // RIS
+    try testing.expect(tracker.sequence() == null);
+
+    tracker.track("\x1b[5 q");
+    try testing.expect(tracker.sequence() != null);
+    tracker.track("\x1b[!p"); // DECSTR
+    try testing.expect(tracker.sequence() == null);
+}
+
+test "CursorShapeTracker replay restores the shape in a fresh terminal" {
+    const alloc = testing.allocator;
+
+    // DECSCUSR 5 selects a blinking bar cursor.
+    var tracker = CursorShapeTracker{};
+    tracker.track("\x1b[5 q");
+
+    var client = try ghostty_vt.Terminal.init(alloc, .{
+        .cols = 80,
+        .rows = 24,
+        .max_scrollback = 0,
+    });
+    defer client.deinit(alloc);
+    var stream = client.vtStream();
+    defer stream.deinit();
+    stream.nextSlice(tracker.sequence().?);
+
+    try testing.expect(client.screens.active.cursor.cursor_style == .bar);
+    try testing.expect(client.modes.get(.cursor_blinking));
+}
+
+test "CursorShapeTracker replay restores a steady shape with blink off" {
+    const alloc = testing.allocator;
+
+    // DECSCUSR 2 selects a steady block cursor (blink off).
+    var tracker = CursorShapeTracker{};
+    tracker.track("\x1b[2 q");
+
+    var client = try ghostty_vt.Terminal.init(alloc, .{
+        .cols = 80,
+        .rows = 24,
+        .max_scrollback = 0,
+    });
+    defer client.deinit(alloc);
+    var stream = client.vtStream();
+    defer stream.deinit();
+    stream.nextSlice(tracker.sequence().?);
+
+    try testing.expect(client.screens.active.cursor.cursor_style == .block);
+    try testing.expect(!client.modes.get(.cursor_blinking));
+}
