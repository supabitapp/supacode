+/// Captures the most recent DECSCUSR (`CSI Ps SP q`) cursor shape from the PTY
+/// stream and replays it on reattach, since the ghostty-vt formatter restores
+/// SGR style and modes but never the cursor shape. The literal bytes are kept
+/// (parsed state can't tell an explicit steady block from the default) and
+/// cleared on a hard reset (RIS or DECSTR). Allocation-free; fixed buffer.
+pub const CursorShapeTracker = struct {
+    state: State = .ground,
+    body: [max_body]u8 = undefined,
+    body_len: usize = 0,
+    overflow: bool = false,
+    captured: [max_seq]u8 = undefined,
+    captured_len: usize = 0,
+
+    // A DECSCUSR body is a short numeric parameter plus one space intermediate.
+    const max_body = 16;
+    // `\x1b[` + body + final byte.
+    const max_seq = max_body + 3;
+
+    const State = enum { ground, esc, csi };
+
+    /// The replay sequence for the current cursor shape, or null if none seen.
+    /// Borrowed from internal storage: invalid after the next `track()`, so copy
+    /// it before tracking more input.
+    pub fn sequence(self: *const CursorShapeTracker) ?[]const u8 {
+        if (self.captured_len == 0) return null;
+        return self.captured[0..self.captured_len];
+    }
+
+    pub fn track(self: *CursorShapeTracker, input: []const u8) void {
+        // Fast path: nothing to parse while idle and free of an ESC. Only the
+        // 7-bit `ESC [` introducer is honored; the 8-bit C1 CSI (0x9b) is a UTF-8
+        // continuation byte, so treating it as a control would mis-parse text.
+        if (self.state == .ground and std.mem.indexOfScalar(u8, input, 0x1b) == null) {
+            return;
+        }
+        for (input) |byte| self.step(byte);
+    }
+
+    fn step(self: *CursorShapeTracker, byte: u8) void {
+        switch (self.state) {
+            .ground => switch (byte) {
+                0x1b => self.state = .esc,
+                else => {},
+            },
+            .esc => switch (byte) {
+                '[' => self.beginCsi(),
+                'c' => self.reset(), // RIS resets the cursor to the terminal default.
+                0x1b => {}, // ESC ESC: stay armed on the trailing ESC.
+                else => self.state = .ground,
+            },
+            .csi => self.stepCsi(byte),
+        }
+    }
+
+    fn beginCsi(self: *CursorShapeTracker) void {
+        self.body_len = 0;
+        self.overflow = false;
+        self.state = .csi;
+    }
+
+    fn reset(self: *CursorShapeTracker) void {
+        self.captured_len = 0;
+        self.state = .ground;
+    }
+
+    fn stepCsi(self: *CursorShapeTracker, byte: u8) void {
+        // Parameter (0x30-0x3f) and intermediate (0x20-0x2f) bytes form the body.
+        if (byte >= 0x20 and byte <= 0x3f) {
+            if (self.body_len < max_body) {
+                self.body[self.body_len] = byte;
+                self.body_len += 1;
+            } else {
+                self.overflow = true;
+            }
+            return;
+        }
+        // A final byte (0x40-0x7e) terminates the sequence.
+        if (byte >= 0x40 and byte <= 0x7e) {
+            if (!self.overflow) self.finishCsi(byte);
+            self.state = .ground;
+            return;
+        }
+        // Any other byte aborts; a fresh ESC re-arms the parser.
+        self.state = if (byte == 0x1b) .esc else .ground;
+    }
+
+    fn finishCsi(self: *CursorShapeTracker, final: u8) void {
+        const body = self.body[0..self.body_len];
+        // DECSTR (`CSI ! p`) resets the terminal, including the cursor shape.
+        if (final == 'p' and body.len == 1 and body[0] == '!') {
+            self.captured_len = 0;
+            return;
+        }
+        // DECSCUSR (`CSI Ps SP q`) takes 0 or 1 numeric parameter with value 0-6
+        // then one space. Validate numerically (matching ghostty-vt, which accepts
+        // leading zeros like `05`) so a stray ` q`, DECSCA `"q`, multi-param, or
+        // out-of-range final can't overwrite a valid capture.
+        if (final != 'q') return;
+        if (body.len == 0 or body[body.len - 1] != ' ') return;
+        var value: u16 = 0;
+        for (body[0 .. body.len - 1]) |c| {
+            if (c < '0' or c > '9') return; // non-digit, e.g. `;` multi-param or `"`.
+            value = value * 10 + (c - '0');
+            if (value > 6) return; // out of the DECSCUSR range.
+        }
+        // Build the replay in the canonical `\x1b[` form.
+        self.captured[0] = 0x1b;
+        self.captured[1] = '[';
+        @memcpy(self.captured[2 .. 2 + body.len], body);
+        self.captured[2 + body.len] = 'q';
+        self.captured_len = 2 + body.len + 1;
+    }
+};
